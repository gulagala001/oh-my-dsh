@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, symlinkSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join, parse, resolve } from 'node:path';
+import { releaseOutputDirectory } from './output-directory.ts';
+
+test('rejects empty output, checkout, filesystem root, ancestors and symlink aliases without deleting anything', t => {
+  const base = mkdtempSync(join(tmpdir(), 'omd-pack-guard-'));
+  t.after(() => rmSync(base, { recursive: true, force: true }));
+  const root = join(base, 'checkout'), output = join(root, 'dist', 'npm');
+  mkdirSync(root); writeFileSync(join(root, 'keep.txt'), 'UNCHANGED');
+  for (const raw of ['', ' ', '.', './', root, '..', dirname(root), parse(root).root]) {
+    assert.throws(() => releaseOutputDirectory(root, raw), /output|--out/);
+    assert.equal(readFileSync(join(root, 'keep.txt'), 'utf8'), 'UNCHANGED');
+  }
+  const alias = join(base, 'alias'); symlinkSync(root, alias, 'junction');
+  assert.throws(() => releaseOutputDirectory(root, alias), /checkout/);
+  assert.throws(() => releaseOutputDirectory(alias, root), /checkout/);
+  assert.equal(releaseOutputDirectory(root, undefined), output);
+  assert.equal(releaseOutputDirectory(root, 'dist/npm'), output);
+  assert.equal(releaseOutputDirectory(root, '../artifacts'), resolve(base, 'artifacts'));
+  assert.equal(releaseOutputDirectory(root, join(alias, 'dist/npm')), join(alias, 'dist/npm'));
+  assert.equal(readFileSync(join(root, 'keep.txt'), 'utf8'), 'UNCHANGED');
+});
diff --git a/scripts/release/output-directory.ts b/scripts/release/output-directory.ts
new file mode 100644
index 00000000..2d24e679
--- /dev/null
+++ b/scripts/release/output-directory.ts
@@ -0,0 +1,28 @@
+import { lstatSync, realpathSync } from 'node:fs';
+import { dirname, isAbsolute, relative, resolve } from 'node:path';
+
+// Resolve existing ancestors as well, so an output alias cannot turn into the
+// checkout itself when its final component has not been created yet.
+function physicalPath(path: string): string {
+  try { lstatSync(path); return realpathSync(path); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+    const parent = dirname(path);
+    if (parent === path) throw error;
+    return resolve(physicalPath(parent), relative(parent, path));
+  }
+}
+const contains = (directory: string, path: string): boolean => {
+  const tail = relative(directory, path);
+  return tail === '' || (!isAbsolute(tail) && tail !== '..' && !tail.startsWith('../') && !tail.startsWith('..\\'));
+};
+
+export function releaseOutputDirectory(root: string, raw: string | undefined, fallback = 'dist/npm'): string {
+  if (raw !== undefined && !raw.trim()) throw new Error('release pack: --out must not be empty');
+  const destination = resolve(root, raw ?? fallback);
+  const physicalRoot = physicalPath(resolve(root)), physicalOutput = physicalPath(destination);
+  if (contains(destination, resolve(root)) || contains(physicalOutput, physicalRoot)) {
+    throw new Error('release pack: output must not be the checkout or any ancestor of it');
+  }
+  return destination;
+}
