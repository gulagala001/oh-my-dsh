{
  "name": "trisoul_x",
  "version": "1.3.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "DSH 工作台：后台分段预处理、四选一替换中枢、项目摘要时间轴、任务验收与电脑操控。",
  "packageManager": "pnpm@11.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/oh-my-dsh.git"
  },
  "homepage": "https://github.com/gulagala001/oh-my-dsh#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/oh-my-dsh/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "memory",
    "context",
    "plugin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/build.mjs && node scripts/start.mjs",
    "test": "node --test test/*.test.mjs",
    "test:context": "node --test test/context-*.test.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "html-to-text": "10.0.1",
    "htmlparser2": "10.1.0",
    "marked": "18.0.12",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=22.19"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./agent": "./src/dsh-agent.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "vendor"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-compaction": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "imports": {
    "#opencu/integration": "./vendor/opencu/src/integration.mjs",
    "#opencu/client-source": "./vendor/opencu/src/client/computer-use.jsx",
    "#opencu/*": "./vendor/opencu/*"
  }
}
