{
  "name": "oh-my-dsh",
  "version": "0.2.1-rc.5.omd.1.3.1",
  "private": true,
  "type": "module",
  "description": "DSH 增强插件：长上下文、任务验证、提示词优化、代码理解、电脑操作，以及 DSH 原生界面与可选主题、配色和背景。",
  "packageManager": "pnpm@11.28.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/oh-my-dsh.git"
  },
  "homepage": "https://github.com/gulagala001/oh-my-dsh#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/oh-my-dsh/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "memory",
    "context",
    "plugin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/build.mjs && node scripts/start.mjs",
    "offline:prepare": "node scripts/prepare-offline.mjs",
    "offline:check": "node scripts/check-offline.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "test": "node scripts/test-ci.mjs run core",
    "test:context": "node --test test/context-*.test.mjs",
    "simulate": "node scripts/simulate.mjs",
    "plugins:submissions": "node scripts/plugin-submissions.mjs",
    "prepack": "npm run metering:check && npm run tools:check && npm run prompts:check && npm run docs:check && node scripts/check-public-files.mjs",
    "prompts:check": "node scripts/check-prompt-styles.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/build-credits.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "release:check": "node scripts/check-release-assets.mjs",
    "market:check": "node scripts/check-market-release.mjs",
    "credits:write": "node scripts/build-credits.mjs --write",
    "credits:check": "node scripts/build-credits.mjs",
    "metering:check": "node scripts/check-metering.mjs",
    "tools:check": "node scripts/build-metering.mjs && node scripts/check-tool-contracts.mjs",
    "perf:tools": "node scripts/tool-performance/run.mjs"
  },
  "dependencies": {
    "@ast-grep/wasm": "0.51.0",
    "@colbymchenry/codegraph": "1.6.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@mozilla/readability": "0.6.0",
    "@toon-format/toon": "4.4.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "acorn": "8.18.0",
    "csv-parse": "7.0.3",
    "diff": "9.0.0",
    "exceljs": "4.4.0",
    "html-to-text": "10.0.1",
    "htmlparser2": "10.1.0",
    "jsdom": "26.1.0",
    "mammoth": "1.13.0",
    "marked": "18.0.12",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "web-tree-sitter": "0.26.0",
    "ws": "8.21.3",
    "yaml": "2.8.1",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.5"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./agent": "./src/dsh-agent.mjs",
    "./opencu": "./vendor/opencu/src/dsh/index.mjs",
    "./codegraph": "./src/codegraph-agent.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./ptc": "./src/ptc.mjs",
    "./host/*": "./lib/host/*.mjs",
    "./host/ui-chat": "./src/host/ui-chat.mjs",
    "./deepseek-workbench": "./plugins/deepseek-workbench/src/index.mjs",
    "./extensions": "./plugins/dsh-extensions/src/index.mjs",
    "./workflow": "./vendor/workflow/src/index.mjs",
    "./rewind": "./vendor/rewind/src/index.mjs",
    "./response-id-reuse": "./vendor/response-id-reuse/src/index.mjs",
    "./token-meter": "./lib/host/token-meter.mjs",
    "./compaction": "./lib/host/compaction.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "plugins",
    "CONTRIBUTING.md",
    "scripts",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "!docs/images",
    "!docs/index.html",
    "!docs/index_EN.html",
    "!docs/site/*.css",
    "!docs/site/*.js",
    "!scripts/build-docs.mjs",
    "!scripts/plugin-submissions.mjs",
    "!scripts/deepswe",
    "!scripts/tool-performance",
    "vendor",
    "!vendor/opencu/lib/client.js",
    "!vendor/opencu/lib/client.factory.mjs",
    "release-manifest.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@mermaid-js/tiny": "12.0.0",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "imports": {
    "#opencu/integration": "./vendor/opencu/src/dsh/index.mjs",
    "#opencu/*": "./vendor/opencu/*"
  },
  "license": "MIT"
}
