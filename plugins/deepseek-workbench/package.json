{
  "name": "dsh-deepseek-workbench",
  "version": "0.1.3-dsh.0.2.1-rc.3",
  "description": "DeepSeek 网页聊天、临时侧栏聊天、API 开放平台与 DSH 会话迁移。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "desktop",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "prepack": "node scripts/check-docs.mjs && node scripts/prepack.mjs",
    "test": "node --test test/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "release:check": "node scripts/check-release-assets.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.3"
  },
  "dependencies": {
    "marked": "18.0.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-deepseek-workbench.git"
  },
  "homepage": "https://github.com/gulagala001/dsh-deepseek-workbench#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/dsh-deepseek-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "chat",
    "sidebar"
  ],
  "packageManager": "pnpm@11.28.5",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
