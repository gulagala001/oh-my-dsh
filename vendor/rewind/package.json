{
  "name": "@gulagala001/dsh-undo-plugin",
  "version": "0.1.0-dsh.0.2.1-rc.2",
  "type": "module",
  "license": "MIT",
  "description": "Rewind conversations and workspace files in DeepSeek Harness, with undo.",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && node scripts/check-package.mjs"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.DSH",
    "README.zh.md",
    "docs",
    "README_EN.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-undo-plugin.git"
  },
  "homepage": "https://github.com/gulagala001/dsh-undo-plugin#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/dsh-undo-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rewind",
    "undo",
    "checkpoint"
  ]
}
