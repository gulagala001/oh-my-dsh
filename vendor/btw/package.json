{
  "name": "@gulagala001/dsh-btw",
  "version": "0.1.1-dsh.0.2.1-rc.2",
  "description": "Ask side questions in DeepSeek Harness without interrupting the current task.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && npm run check:public",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "README_EN.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "btw",
    "side-chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-btw.git"
  },
  "homepage": "https://github.com/gulagala001/dsh-btw#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/dsh-btw/issues"
  },
  "author": "gulagala001"
}
