{
  "name": "dsh-workflow-plus",
  "version": "0.1.2-dsh.0.2.1-rc.2",
  "description": "Resumable JavaScript workflows, native subagents, token budgets and worktree isolation for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./engine": "./src/engine.mjs",
    "./tool": "./src/tool.mjs",
    "./spawn": "./src/spawn.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-workflow.git"
  },
  "homepage": "https://github.com/gulagala001/dsh-workflow#readme",
  "bugs": {
    "url": "https://github.com/gulagala001/dsh-workflow/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "subagents",
    "orchestration"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "prepack": "node scripts/check-docs.mjs && node scripts/prepack.mjs",
    "test": "node --test test/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "release:check": "node scripts/check-release-assets.mjs"
  },
  "files": [
    "src",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "scripts"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "acorn": "8.18.0",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-job-controller"
      ]
    }
  }
}
