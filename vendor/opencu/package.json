{
  "name": "opencu",
  "version": "2.0.8-dsh.0.2.1-rc.1",
  "description": "Computer-use plugin with original REA browser, annotation and monitoring components for DSH",
  "type": "module",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.1"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core/controller.mjs",
    "./browser": "./src/browser/backend.mjs",
    "./native": "./src/native/backend.mjs",
    "./extension": "./src/extension/backend.mjs",
    "./dsh": "./src/dsh/index.mjs",
    "./integration": "./src/dsh/index.mjs",
    "./client": "./lib/client.js",
    "./protocol": "./src/protocol.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "src/",
    "lib/",
    "host/",
    "cordis.patch.yml",
    "native/macos/",
    "native/windows/",
    "native/linux/",
    "native/bin/",
    "extension/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "!src/client/",
    "!**/.*/**",
    "!**/.*",
    "README_EN.md",
    "DEVELOPMENT.md",
    "docs/",
    "CHANGELOG.md",
    "scripts/check-docs.mjs",
    "scripts/check-release-assets.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:targets": "node scripts/build-targets.mjs",
    "pack": "node scripts/pack.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "prepack": "node scripts/check-docs.mjs && node scripts/build.mjs && node scripts/check-extension-distribution.mjs && node scripts/check-public-files.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "release:check": "node scripts/check-release-assets.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-compiler-runtime": "1.0.0",
    "esbuild": "0.25.12",
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "acorn": "8.18.0",
    "@babel/generator": "7.29.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "opencu": {
    "host": "0.2.1-rc.1",
    "sourceCommit": "1600d8a1e140dcde43a1a0941940a0480712c011",
    "adapterRevision": 2
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/opencu.git"
  }
}
