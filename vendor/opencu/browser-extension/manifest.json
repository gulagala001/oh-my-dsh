{
  "manifest_version": 3,
  "name": "Oh My DSH Computer Use",
  "version": "0.1.3",
  "minimum_chrome_version": "125",
  "description": "连接 Oh My DSH，查看和操作当前浏览器中选中的标签页。",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oh My DSH Computer Use"
  },
  "key": ""
}
